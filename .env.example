DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
JWT_SECRET=change-me-to-a-long-random-string
APP_USERNAME=admin
APP_PASSWORD=change-me
CRON_SECRET=change-me-too
N8N_ESCALATION_WEBHOOK_URL=http://localhost:5678/webhook/escalate-to-human
# Per-user requests per minute (0 disables). /agent/chat and /agent/triage share the agent limit.
RATE_LIMIT_ASK_PER_MINUTE=10
RATE_LIMIT_AGENT_PER_MINUTE=5
# Login attempts per client IP (counts every attempt, right or wrong; 0 disables)
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_HOUR=30
# Structured JSON logs to stdout (Vercel runtime logs): DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
