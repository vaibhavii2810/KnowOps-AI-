{
  "name": "KnowOps AI — Automated Incident Triage Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "incident-alert",
        "options": {}
      },
      "id": "node-webhook-trigger",
      "name": "Incoming Alert Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "3f1c2a7e-8b4d-4c1e-9a55-1d2e3f4a5b6c"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/auth/login",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "={{ $env.KNOWOPS_USERNAME }}"
            },
            {
              "name": "password",
              "value": "={{ $env.KNOWOPS_PASSWORD }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-login",
      "name": "Log In to KnowOps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        350,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/tickets",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "subject",
              "value": "={{ $('Incoming Alert Webhook').item.json.body.alert_name || 'Production Alert: High Error Rate' }}"
            },
            {
              "name": "description",
              "value": "={{ $('Incoming Alert Webhook').item.json.body.message || 'Alert triggered from monitoring system. Requires immediate triage.' }}"
            },
            {
              "name": "priority",
              "value": "={{ $('Incoming Alert Webhook').item.json.body.severity || 'P1' }}"
            }
          ]
        },
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Log In to KnowOps').item.json.access_token }}"
            }
          ]
        }
      },
      "id": "node-create-ticket",
      "name": "Create Incident Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        570,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8000/agent/triage/{{ $json.id }}",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Log In to KnowOps').item.json.access_token }}"
            }
          ]
        }
      },
      "id": "node-agent-triage",
      "name": "Autonomous Agent Triage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        790,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/mock/webhook/knowops-incidents",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=🚨 *Incident #{{ $json.ticket_id }} Triaged by KnowOps Agent*\n*Subject:* {{ $json.initial_ticket.subject }}\n*Resolution:* {{ $json.resolution_summary }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-notify-slack",
      "name": "Notify On-Call Channel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1010,
        300
      ]
    }
  ],
  "connections": {
    "Incoming Alert Webhook": {
      "main": [
        [
          {
            "node": "Log In to KnowOps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Incident Ticket": {
      "main": [
        [
          {
            "node": "Autonomous Agent Triage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Autonomous Agent Triage": {
      "main": [
        [
          {
            "node": "Notify On-Call Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log In to KnowOps": {
      "main": [
        [
          {
            "node": "Create Incident Ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {}
}
