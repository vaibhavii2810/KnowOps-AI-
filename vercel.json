{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "regions": ["sin1"],
  "functions": {
    "api/index.py": { "includeFiles": "{static,data}/**" }
  },
  "schedules": {
    "reindex": {
      "schedule": "0 3 * * *",
      "path": "/cron/reindex",
      "requestMethod": "GET"
    }
  }
}
